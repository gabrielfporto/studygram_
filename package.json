{
  "name": "studygram-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json",
    "test": "tsx --tsconfig tsconfig.web.json --test tests/*.test.ts tests/*.test.tsx",
    "simulate": "tsx simulation/run.ts",
    "check": "npm run typecheck && npm test && npm run simulate",
    "dev": "vite",
    "build": "tsc -p tsconfig.web.json && vite build",
    "build:edge": "node scripts/build-edge.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "@supabase/supabase-js": "2.117.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ts-fsrs": "5.4.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@testing-library/react": "16.3.3",
    "@types/jsdom": "30.0.0",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "0.28.2",
    "jsdom": "30.1.2",
    "supabase": "2.121.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
